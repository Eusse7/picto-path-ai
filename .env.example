# ==========================================
# Picto-Path AI - Configuración de Entorno
# ==========================================

# Configuración General Backend (FastAPI)
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# PostgreSQL
POSTGRES_USER=picto_user
POSTGRES_PASSWORD=picto_secure_password
POSTGRES_DB=picto_path_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ChromaDB (Vector Store)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Frontend
FRONTEND_PORT=3000
